{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "vinext build && node scripts/prepare-sites-package.mjs",
    "start": "next start",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --import-plugin --deny-warnings src tests next.config.ts playwright.config.ts playwright.sites.config.ts scripts/build-sites-local.mjs scripts/evaluate-model-quality.ts scripts/playwright-next-server.mjs scripts/playwright-sites-server.mjs scripts/playwright-server-lifecycle.mjs scripts/prepare-sites-package.mjs && eslint src tests next.config.ts playwright.config.ts playwright.sites.config.ts scripts/build-sites-local.mjs scripts/evaluate-model-quality.ts scripts/playwright-next-server.mjs scripts/playwright-sites-server.mjs scripts/playwright-server-lifecycle.mjs scripts/prepare-sites-package.mjs",
    "test:e2e": "playwright test",
    "eval:model-quality": "node --experimental-strip-types scripts/evaluate-model-quality.ts",
    "test:smoke:sites": "node scripts/build-sites-local.mjs && playwright test --config=playwright.sites.config.ts",
    "prepare:deploy:sites": "npm run build:sites",
    "check:release": "node scripts/check-release-env.mjs",
    "check:production": "node scripts/check-production-health.mjs",
    "backup:firestore": "node scripts/backup-firestore.mjs --wait",
    "restore:firestore": "node scripts/restore-firestore.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "firebase": "^12.16.0",
    "lucide-react": "^1.24.0",
    "next": "^16.2.12",
    "openai": "^6.47.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "oxlint": "^1.76.0",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "postcss": "^8.5.25",
    "sharp": "^0.35.2",
    "ws": "^8.20.2"
  },
  "type": "module"
}
