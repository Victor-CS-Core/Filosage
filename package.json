{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --import-plugin --deny-warnings src tests scripts next.config.ts playwright.config.ts playwright.api.config.ts playwright.contracts.config.ts playwright.command-center-v2.config.ts playwright.command-center-v2-ui.config.ts playwright.shared-evidence.config.ts && eslint src tests scripts next.config.ts playwright.config.ts playwright.api.config.ts playwright.contracts.config.ts playwright.command-center-v2.config.ts playwright.command-center-v2-ui.config.ts playwright.shared-evidence.config.ts",
    "test:e2e": "node --experimental-strip-types scripts/run-playwright-suites.mjs",
    "test:postgres": "node --conditions=react-server --import tsx --test --test-concurrency=1 --test-reporter=tap tests/postgres/*.test.ts",
    "test:billing": "node --conditions=react-server --import tsx --experimental-test-module-mocks --test --test-concurrency=1 --test-reporter=tap tests/billing/*.test.mjs tests/billing/*.test.ts",
    "test:contracts": "playwright test --config=playwright.contracts.config.ts",
    "test:api": "playwright test --config=playwright.api.config.ts",
    "test:browser": "node --experimental-strip-types scripts/run-playwright-matrix.mjs",
    "test:browser:smoke": "node --experimental-strip-types scripts/run-playwright-smoke.mjs",
    "test:command-center:v2": "playwright test --config=playwright.command-center-v2.config.ts",
    "test:command-center:v2:ui": "playwright test --config=playwright.command-center-v2-ui.config.ts",
    "test:shared-evidence:ui": "playwright test --config=playwright.shared-evidence.config.ts",
    "eval:model-quality": "node --conditions=react-server --import tsx scripts/evaluate-model-quality.ts",
    "test:eval-harness": "node --import tsx --test tests/evals/*.test.ts",
    "eval:command-center": "node --experimental-strip-types scripts/evaluate-command-center-drafts.ts",
    "check:release": "node scripts/check-release-env.mjs",
    "check:production": "node scripts/check-production-health.mjs",
    "check:featured-course": "node scripts/check-featured-course.mjs",
    "check:secrets": "node scripts/check-tracked-secrets.mjs",
    "check:release-safety": "node scripts/check-release-safety.mjs",
    "check:support-wiki": "node scripts/check-support-wiki.mjs",
    "seed:local-carousel": "node --experimental-strip-types scripts/seed-local-carousel-courses.ts",
    "test:operations-alert": "node --experimental-strip-types scripts/test-operational-alert.ts",
    "migrate:identity-links": "node --conditions=react-server --import tsx scripts/backfill-identity-links.ts",
    "maintenance:identity-link-intents": "node --conditions=react-server --import tsx scripts/prune-identity-link-intents.ts",
    "migrate:azure:database": "node --experimental-strip-types scripts/migrate-azure-database.ts",
    "migrate:azure:complete-courses": "node --experimental-strip-types scripts/complete-azure-course-bundle.ts",
    "migrate:azure:import-courses": "node --experimental-strip-types scripts/import-azure-authored-courses.ts",
    "migrate:azure:verify-courses": "node --experimental-strip-types scripts/verify-azure-authored-courses.ts",
    "test:evaluation-budget": "node --conditions=react-server --import tsx --test --test-concurrency=1 --test-reporter=tap tests/evaluation-budget/*.test.ts",
    "test:lesson-integrity": "node --conditions=react-server --import tsx --experimental-test-module-mocks --test --test-concurrency=1 --test-reporter=tap tests/lesson-integrity/*.test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.33.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "lucide-react": "^1.24.0",
    "motion": "^13.1.0",
    "next": "^16.2.12",
    "openai": "^6.47.0",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "postcss": "^8.5.25",
    "sharp": "^0.35.2",
    "undici": "^7.29.0",
    "ws": "^8.20.2"
  },
  "type": "module"
}
