NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Full 40-character Git commit SHA for the exact deployed source.
SITE_VERSION=
ALLOWED_ORIGINS=

# Azure PostgreSQL document store. When DATABASE_URL is set, server data reads
# and writes use PostgreSQL instead of Firestore. Use verify-full in Azure.
DATABASE_URL=
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# Azure Container Apps built-in authentication (Easy Auth) handles Google
# OAuth and the session before requests reach Next.js. Keep this true only when
# the Container Apps auth sidecar is enabled; otherwise authentication fails closed.
AZURE_EASY_AUTH_ENABLED=false

# Azure Blob Storage. Production uses the account URL with the Container App's
# managed identity. A connection string is supported only for local emulation.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_BANNER_CONTAINER=course-banners
AZURE_STORAGE_CONNECTION_STRING=

# One-time Firebase source credentials used only by the authored-course
# migration exporter. Do not configure these on the Azure Container App.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
OWNER_EMAIL=owner@example.com
# At least 32 random bytes. Rotating it invalidates outstanding creator activity receipts.
ACTIVITY_RECEIPT_SECRET=

# Production operations (required for release readiness)
# Azure PostgreSQL automated backup retention is configured in Bicep. Record a
# successful recovery-environment restore before launch.
AZURE_POSTGRES_SERVER_NAME=
AZURE_RESOURCE_GROUP=
OPERATIONS_ALERT_WEBHOOK_URL=
# At least 32 random bytes. Used to sign the exact alert body with HMAC-SHA256.
OPERATIONS_ALERT_WEBHOOK_SECRET=
# Label included in operational envelopes sent outside the application.
OPERATIONS_ENVIRONMENT=production
PRODUCTION_HEALTH_URL=

# Public commercial disclosures. Do not enable billing until the owner approves
# these exact values for publication in the Terms and Privacy Notice.
LEGAL_OPERATOR_NAME=
LEGAL_BUSINESS_ADDRESS=
GOVERNING_JURISDICTION=
SUPPORT_EMAIL=support@filosage.com

# Owner-only Agent Command Center. Keep false until its release gate is approved.
COMMAND_CENTER_ENABLED=false
COMMAND_CENTER_DRAFTS_ENABLED=false
NEXT_PUBLIC_COMMAND_CENTER_V2=false
OPENAI_COMMAND_CENTER_MODEL=gpt-5.6-terra

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_COURSE_MODEL=gpt-5.6-terra
# Sol is used only after the normal course generation and Terra repair paths fail.
OPENAI_COURSE_RECOVERY_MODEL=gpt-5.6-sol
OPENAI_LESSON_MODEL=gpt-5.6-luna
OPENAI_LESSON_FALLBACK_MODEL=gpt-5.6-terra
# Sol is used only after the normal Luna and Terra lesson paths fail.
OPENAI_LESSON_RECOVERY_MODEL=gpt-5.6-sol
OPENAI_TUTOR_MODEL=gpt-5.6-luna
# Private flashcard decks remain production-disabled until the release gate is approved.
FLASHCARD_DECKS_ENABLED=false
FLASHCARD_AI_GENERATION_ENABLED=false
OPENAI_FLASHCARD_MODEL=gpt-5.6-luna
# Optional shared override for baseline and capstone assessment. Defaults to the tutor model.
OPENAI_ASSESSMENT_MODEL=gpt-5.6-luna
# One low-cost, reusable landscape image is generated for each unique course brief.
# Set false for an emergency stop; the UI retains deterministic on-brand banners.
COURSE_BANNERS_ENABLED=true
OPENAI_COURSE_IMAGE_MODEL=gpt-image-1-mini
# Enables structured, deterministic lesson visuals for newly generated lessons.
# Existing lessons remain unchanged; use true only when the curated visual rollout is ready.
LESSON_VISUALS_ENABLED=false
# Course Intelligence Pipeline V2 kill switches. Keep all false until the
# offline corpus and owner canary gates in docs/course-pipeline-v2 pass.
COURSE_PIPELINE_V2=false
# Decision-changing V2 paths are owner-only by default. Set this false and
# choose a stable percentage only after the owner canary passes.
COURSE_PIPELINE_V2_OWNER_ONLY=true
COURSE_PIPELINE_V2_COHORT_PERCENT=0
COURSE_VALIDATION_V2=false
COURSE_REPAIR_V2=false
COURSE_LABS_V2=false
COURSE_VISUALS_V2=false
COURSE_PUBLICATION_V2=false
COURSE_PIPELINE_SHADOW_MODE=false
# Dashboard estimates use the model-specific rates in src/lib/ai-pricing.ts.
# Independent pools prevent free trials from consuming paid capacity.
OPENAI_FREE_MONTHLY_BUDGET_USD=25
OPENAI_PAID_MONTHLY_BUDGET_USD=500
OPENAI_OWNER_MONTHLY_BUDGET_USD=50
# Per-account cost ceilings provide a second guard beyond request quotas.
OPENAI_FREE_USER_MONTHLY_BUDGET_USD=0.15
OPENAI_PLUS_USER_MONTHLY_BUDGET_USD=3
OPENAI_PRO_USER_MONTHLY_BUDGET_USD=6
OPENAI_OWNER_USER_MONTHLY_BUDGET_USD=50

# Optional comma-separated Pro access while billing is being configured.
# The verified Google account matching OWNER_EMAIL is always treated as Pro.
PREMIUM_EMAILS=

# Billing (GoDaddy can host the site/domain; subscriptions require a payment provider.)
BILLING_PROVIDER=none
# Deliberate second lock: subscriptions remain unavailable unless this is true.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
# Comma-separated historical Pro Prices that must keep receiving lifecycle updates.
STRIPE_PRO_LEGACY_PRICE_IDS=
