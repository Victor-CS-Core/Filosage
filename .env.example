# Browser Firebase configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server Firebase Admin configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
OWNER_EMAIL=owner@example.com

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_COURSE_MODEL=gpt-5.6-terra
OPENAI_LESSON_MODEL=gpt-5.6-terra
OPENAI_TUTOR_MODEL=gpt-5.6-luna
OPENAI_INPUT_COST_PER_MILLION=2.5
OPENAI_OUTPUT_COST_PER_MILLION=15
OPENAI_TUTOR_INPUT_COST_PER_MILLION=1
OPENAI_TUTOR_OUTPUT_COST_PER_MILLION=6
OPENAI_MONTHLY_BUDGET_USD=50

# Optional comma-separated Pro access while billing is being configured.
# The verified Google account matching OWNER_EMAIL is always treated as Pro.
PREMIUM_EMAILS=

# Billing (activate only after creating the provider products/prices)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
