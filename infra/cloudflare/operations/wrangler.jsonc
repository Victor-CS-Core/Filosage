{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "filosage-operations",
  "main": "worker.mjs",
  "account_id": "447a556505dd5e72b66e7c1c63d754ae",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "filosage-operations",
      "database_id": "8b75b7b7-4e40-4a1e-8f1a-b5bdc5af5e83"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "ALERT_FROM": "operations@alerts.filosage.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER",
        "class_name": "AlertScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AlertScheduler"
      ]
    }
  ]
}
